{
  "name": "@entra-explorer/backend",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=json --coverage.reporter=json-summary --coverage.all --coverage.include=src --coverage.exclude=src/**/*.test.ts --coverage.exclude=src/test-support.ts --coverage.exclude=src/index.ts",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@entra-explorer/domain": "workspace:*",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "24.3.0",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "3.2.6",
    "typescript": "5.9.2",
    "vitest": "4.1.11"
  }
}
