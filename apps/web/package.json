{
  "name": "@entra-explorer/web",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx worker.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run server",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run server --coverage --coverage.reporter=text-summary --coverage.reporter=json --coverage.reporter=json-summary --coverage.include='server/**/*.ts' --coverage.exclude=server/**/*.test.ts",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@azure/msal-node": "6.0.0",
    "@entra-explorer/backend": "workspace:*",
    "@entra-explorer/domain": "workspace:*",
    "@entra-explorer/graph": "workspace:*",
    "cytoscape": "3.34.3",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "tsx": "4.23.15",
    "@entra-explorer/engine": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "24.19.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/coverage-v8": "5.0.3",
    "typescript": "5.9.2",
    "vitest": "5.0.3"
  }
}
