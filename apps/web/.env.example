# Phase 1 remains disabled unless this flag is explicitly set to true.
ENTRA_ENABLE_LIVE=false

# Use one concrete tenant. Do not use common or organizations.
ENTRA_TENANT_ID=00000000-0000-4000-8000-000000000000
ENTRA_CLIENT_ID=00000000-0000-4000-8000-000000000000

# Local/admin MVP only. Never commit a value. Production-style local containers
# permit this only with an explicit flag and a loopback redirect.
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback
ENTRA_ALLOW_LOCAL_CLIENT_SECRET=false

# Optional, separately consented read-only evidence. Leave empty for the core scan.
# Allowed: RoleManagement.Read.Directory Policy.Read.All AuditLog.Read.All
ENTRA_OPTIONAL_GRAPH_SCOPES=

# Generate locally with: openssl rand -base64 32
# Use Azure Key Vault for an approved deployed environment.
ENTRA_DATA_ENCRYPTION_KEY=
DATABASE_URL=postgresql://entra:local-password@127.0.0.1:54320/entra_explorer
