              "attrs": { ".element-shape": { "class": "element-shape hasNoOpenThreats isInScope" }, "text": { "text": "ta-pg-volume\nPersistent volume" }, ".element-text": { "class": "element-text hasNoOpenThreats isInScope" } }
            },
