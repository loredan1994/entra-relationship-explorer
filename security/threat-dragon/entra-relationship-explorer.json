              "description": "ta-browser. Operator-controlled browser on the local device. Processes da-oauth-flow, da-tenant-session, da-tenant-snapshot, and da-csv-export.",
              "attrs": { ".element-shape": { "class": "element-shape hasNoOpenThreats isInScope" }, "text": { "text": "ta-browser\nLocal browser" }, ".element-text": { "class": "element-text hasNoOpenThreats isInScope" } }
            },
            {
              "type": "tm.Process", "size": { "width": 140, "height": 110 }, "position": { "x": 380, "y": 140 }, "angle": 0,
              "id": "00000000-0000-4000-8000-000000000002", "z": 2, "hasOpenThreats": true, "isWebApplication": true,
              "description": "ta-web. Next.js web container on loopback. Stores no plaintext tenant payload outside PostgreSQL and never calls Microsoft Graph directly.",
              "threats": [
                { "title": "thr-002 Cross-tenant disclosure", "type": "Information disclosure", "modelType": "STRIDE", "status": "Mitigated", "severity": "High", "description": "A session or resource identifier could be used to retrieve another tenant's session, job, snapshot, or access event.", "mitigation": "Concrete-tenant configuration, tenant-bound cookies and queries, tenant-scoped backend methods, authenticated encryption AAD, and invariant tests.", "threatId": "10000000-0000-4000-8000-000000000002" },
                { "title": "thr-003 OAuth replay or substitution", "type": "Spoofing", "modelType": "STRIDE", "status": "Mitigated", "severity": "High", "description": "A stolen or substituted callback could bind the wrong authorization transaction or tenant.", "mitigation": "Short-lived single-use flow records, 256-bit state, PKCE, constant-time state comparison, tenant binding, and HttpOnly SameSite cookies.", "threatId": "10000000-0000-4000-8000-000000000003" },
                { "title": "thr-007 Sensitive material leakage", "type": "Information disclosure", "modelType": "STRIDE", "status": "Mitigated", "severity": "High", "description": "Secrets, tokens, encryption keys, raw Graph responses, or tenant exports could leak through APIs, logs, reports, or Git.", "mitigation": "Typed sanitization, safe error codes, generic top-level logs, server-only sessions, no-store responses, ignored generated output, and Gitleaks/invariant tests.", "threatId": "10000000-0000-4000-8000-000000000007" },
                { "title": "thr-010 Configured access misrepresented as activity", "type": "Repudiation", "modelType": "STRIDE", "status": "Mitigated", "severity": "Medium", "description": "Configured grants might be presented as evidence that an API was actually used.", "mitigation": "Domain evidence keeps configured=true and observed=null; product language and tests preserve the distinction.", "threatId": "10000000-0000-4000-8000-000000000010" }
              ],
              "attrs": { ".element-shape": { "class": "element-shape hasOpenThreats isInScope" }, "text": { "text": "ta-web\nNext.js web" }, ".element-text": { "class": "element-text hasOpenThreats isInScope" } }
            },
            {
              "type": "tm.Process", "size": { "width": 140, "height": 110 }, "position": { "x": 660, "y": 140 }, "angle": 0,
              "id": "00000000-0000-4000-8000-000000000003", "z": 3, "hasOpenThreats": true,
              "description": "ta-worker. Durable scan worker; sole component allowed to call Microsoft Graph, through df-07 GET-only.",
              "threats": [
                { "title": "thr-001 Entra write capability introduced", "type": "Elevation of privilege", "modelType": "STRIDE", "status": "Mitigated", "severity": "Critical", "description": "A code or configuration change could request write scopes or issue non-GET Microsoft Graph calls.", "mitigation": "Fixed read-only scope allowlist, GET-only transport, explicit read-only model flow, tests, and owner approval required for any separate write phase.", "threatId": "10000000-0000-4000-8000-000000000001" },
                { "title": "thr-004 Job ownership tampering", "type": "Tampering", "modelType": "STRIDE", "status": "Mitigated", "severity": "High", "description": "A worker could update or complete a job claimed by another worker.", "mitigation": "Atomic SKIP LOCKED claim and worker_id/status predicates on every progress, completion, and failure update.", "threatId": "10000000-0000-4000-8000-000000000004" },
                { "title": "thr-006 Throttling or endpoint failure hides partial data", "type": "Denial of service", "modelType": "STRIDE", "status": "Mitigated", "severity": "Medium", "description": "Graph throttling, transient failures, or endpoint denial could exhaust resources or yield a misleading complete result.", "mitigation": "Retry-After, bounded exponential backoff, request/page/item/concurrency limits, durable progress, and explicit partial completion.", "threatId": "10000000-0000-4000-8000-000000000006" }
              ],
              "attrs": { ".element-shape": { "class": "element-shape hasOpenThreats isInScope" }, "text": { "text": "ta-worker\nScan worker" }, ".element-text": { "class": "element-text hasOpenThreats isInScope" } }
            },
            {
              "type": "tm.Process", "size": { "width": 140, "height": 110 }, "position": { "x": 380, "y": 380 }, "angle": 0,
              "id": "00000000-0000-4000-8000-000000000004", "z": 4, "hasOpenThreats": false,
              "description": "ta-migration. One-shot schema migration container. It can change only the local application database, never Microsoft Entra.",
              "attrs": { ".element-shape": { "class": "element-shape hasNoOpenThreats isInScope" }, "text": { "text": "ta-migration\nDB migration" }, ".element-text": { "class": "element-text hasNoOpenThreats isInScope" } }
            },
