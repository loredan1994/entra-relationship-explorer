              "threats": [
                { "title": "thr-008 Ciphertext swap or tampering", "type": "Tampering", "modelType": "STRIDE", "status": "Mitigated", "severity": "High", "description": "Encrypted sessions or snapshots could be moved between tenants/records or modified.", "mitigation": "AES-256-GCM with fresh IVs and AAD containing record type, ID, tenant ID, and snapshot time; tamper and wrong-context tests.", "threatId": "10000000-0000-4000-8000-000000000008" }
              ],
