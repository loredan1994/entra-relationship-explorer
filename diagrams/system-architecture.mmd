flowchart LR
  ADMIN["Tenant administrator<br/>Local browser"]
  WEB["Next.js web app<br/>Sign-in, review, exports"]
  DB[("PostgreSQL<br/>Encrypted sessions, checkpoints,<br/>snapshots, reviews")]
  WORKER["Restart-safe worker<br/>Bounded GET-only collector<br/>Normalization + findings"]
  GRAPH["Microsoft Graph v1.0<br/>Tenant authority"]

  ADMIN -->|"Authorization code + PKCE<br/>Start or cancel scan"| WEB
  WEB -->|"Tenant-scoped jobs and queries"| DB
  DB -->|"Claim queued job<br/>Resume checkpoint"| WORKER
  WORKER -->|"HTTPS GET only<br/>Fixed read-only allowlist"| GRAPH
  GRAPH -->|"Paged directory and policy evidence"| WORKER
  WORKER -->|"Encrypted checkpoint or snapshot<br/>Access event"| DB
  DB -->|"Current + retained snapshots<br/>Finding decisions"| WEB

  NOTE["Local single-tenant deployment<br/>No Entra writes<br/>No token or credential values in snapshots"]
  NOTE -. "enforced boundary" .-> WEB
  NOTE -. "enforced boundary" .-> WORKER

  classDef core fill:#EAF0FF,stroke:#2F6FED,color:#172033,stroke-width:2px;
  classDef data fill:#DDF8F8,stroke:#16B8C4,color:#172033,stroke-width:2px;
  classDef guard fill:#FFF4DC,stroke:#D97706,color:#172033;
  class WEB,WORKER core;
  class GRAPH,DB data;
  class NOTE guard;
