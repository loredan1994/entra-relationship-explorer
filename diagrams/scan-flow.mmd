flowchart LR
  START(["Administrator starts scan"])
  AUTH["Sign in<br/>Approve read-only access"]
  APPS["Read app registrations<br/>Blueprints + roles"]
  SPS["Read service principals<br/>Tenant identities"]
  GRANTS["Read role assignments<br/>and delegated grants"]
  GOV["Read owners and<br/>credential metadata"]
  NORM["Normalize nodes, edges,<br/>and source evidence"]
  STORE[("Save tenant-isolated<br/>snapshot")]
  SHOW["Show completeness report<br/>and relationship map"]

  START --> AUTH --> APPS --> SPS --> GRANTS --> GOV --> NORM --> STORE --> SHOW
  GUARD["READ ONLY<br/>No Entra object is created, edited, or deleted"]
  GUARD -. "applies to every step" .-> AUTH
  GUARD -.-> GOV

  classDef action fill:#EAF0FF,stroke:#2F6FED,color:#172033,stroke-width:2px;
  classDef data fill:#DDF8F8,stroke:#16B8C4,color:#172033,stroke-width:2px;
  classDef guard fill:#FFF4DC,stroke:#D97706,color:#172033;
  class AUTH,APPS,SPS,GRANTS,GOV,NORM,SHOW action;
  class STORE data;
  class GUARD guard;
